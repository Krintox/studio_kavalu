# Copy to .env.local and fill in. Everything is optional: with nothing set, the site runs and
# "Choose your road" saves briefs to .data/briefs.jsonl in development (and says it isn't
# connected in production, offering email instead).

# The public address of the site (used for links, sitemap, social cards)
NEXT_PUBLIC_SITE_URL=https://studiokavalu.com

# --- Briefs by email (Resend, https://resend.com, free for 3,000 emails a month) ---
# Verify a sending domain (e.g. mail.studiokavalu.com) in Resend first.
RESEND_API_KEY=
BRIEF_TO_EMAIL=connect@studiokavalu.com
BRIEF_FROM_EMAIL="Ananya at Studio Kavalu <hello@mail.studiokavalu.com>"

# --- Also log every brief to a Google Sheet (Apps Script web app) ---
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=

# --- Spam protection ---
# Any long random string; signs the form's start time so bots can't fake it.
FORM_SIGNING_SECRET=
# Cloudflare Turnstile (invisible), https://dash.cloudflare.com -> Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Booking + WhatsApp, shown after a brief is sent and in the client's email ---
# A Cal.com link such as studiokavalu/intro, or a full https:// URL
NEXT_PUBLIC_CAL_LINK=
# Digits with country code, no + or spaces, e.g. 919800000000
NEXT_PUBLIC_WHATSAPP_NUMBER=
